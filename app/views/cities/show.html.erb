<h1><%= @city.name %></h1>

<p><strong>Страна:</strong> <%= @city.country %></p>
<p><strong>Температура:</strong> <%= @city.last_temp %> °C</p>

<p>
  <% if current_user&.admin? %>
    <%= link_to "Редактировать", edit_city_path(@city) %> |
  <% end %>
  <%= link_to "Назад к списку", cities_path %>
</p>
