<%= form_with model: city, html: { novalidate: true } do |form| %>

  <% if city.errors.any? %>
    <div style="color: red;">
      <h3>Ошибки:</h3>
      <ul>
        <% city.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Название города" %><br>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :country, "Страна" %><br>
    <%= form.text_field :country %>
  </div>

  <div class="field">
    <%= form.label :last_temp, "Последняя температура (°C)" %><br>
    <%= form.number_field :last_temp %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>

<% end %>
