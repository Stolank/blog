<h1>Города</h1>

<p>
  <%= link_to "Добавить город", new_city_path, class: "btn" %>
</p>

<table>
  <thead>
    <tr>
      <th>Название</th>
      <th>Страна</th>
      <th>Температура (°C)</th>
      <th>Действия</th>
    </tr>
  </thead>

  <tbody>
    <% @cities.each do |city| %>
      <tr>
        <td><%= city.name %></td>
        <td><%= city.country %></td>
        <td><%= city.last_temp %></td>
        <td>
          <%= link_to "Показать", city_path(city) %> |
          <%= link_to "Редактировать", edit_city_path(city) %> |
          <%= button_to "Удалить", city_path(city), method: :delete %>     
        </td>
      </tr>
    <% end %>
  </tbody>
</table>