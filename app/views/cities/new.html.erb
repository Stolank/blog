<h1>New City</h1>

<% if @city.errors.any? %>
  <div style="color: red;">
    <h3>Ошибки:</h3>
    <ul>
      <% @city.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @city do |form| %>
  <div>
    <%= form.label :name, "City Name" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :country, "Country" %>
    <%= form.text_field :country %>
  </div>

  <div>
    <%= form.label :last_temp, "Last Temperature" %>
    <%= form.number_field :last_temp %>
  </div>

  <div>
    <%= form.submit "Create City" %>
  </div>
<% end %>
