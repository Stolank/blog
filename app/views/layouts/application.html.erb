<!DOCTYPE html>
<html lang="ru">
  <head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= content_for?(:title) ? yield(:title) : "Week 7 — Rails" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
     <% if notice.present? %>
  <div class="flash flash--notice" style="background:#e6ffed; border:1px solid #b7eb8f; padding:8px 12px; border-radius:6px; margin:10px;">
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div class="flash flash--alert" style="background:#ffecec; border:1px solid #ffb3b3; padding:8px 12px; border-radius:6px; margin:10px;">
    <%= alert %>
  </div>
  <% end %>
    <header class="site-header">
      <div class="container header-row">
        <h1 class="brand">OldSchool • Rails</h1>
        <nav class="nav">
          <%= link_to "Главная", root_path, class: (request.path == "/" ? "active" : nil) %>
          <%= link_to "Погода", weather_path, class: (request.path.start_with?("/weather") ? "active" : nil) %>
          <% if current_user&.admin? %>
            <%= link_to "Админ-панель", admin_dashboard_path, class: (request.path.start_with?("/admin") ? "active" : nil) %>
          <% end %>

          <% if user_signed_in? %>
        <span style="margin-left:12px;">
          Вошёл: <%= current_user.email %>
        </span>

        <%= link_to "Выйти",
                      destroy_user_session_path,
                      data: { turbo_method: :delete },
                      style:  "margin-left:12px;" %>
      <% else %>
        <%= link_to "Войти", new_user_session_path, style: "margin-left:12px;" %>
        <%= link_to "Регистрация", new_user_registration_path, style: "margin-left:12px;" %>
      <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <small>© <%= Time.current.year %> OldSchool Journal</small>
      </div>
    </footer>
  </body>
</html>
